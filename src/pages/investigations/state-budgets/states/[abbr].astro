---
import fs from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import EventLog from "../../../../components/investigations/state-budgets/EventLog.astro";
import BudgetTimeline from "../../../../components/investigations/state-budgets/BudgetTimeline.svelte";
import FunctionBreakdown from "../../../../components/investigations/state-budgets/FunctionBreakdown.svelte";
import DebtStory from "../../../../components/investigations/state-budgets/DebtStory.svelte";
import ChartFrame from "../../../../components/charts/ChartFrame.astro";
import { withBase } from "../../../../lib/withBase";
import {
  governorForYear,
  label,
  PARTY_NAMES,
  type StateData,
} from "../../../../lib/stateBudgets";

export async function getStaticPaths() {
  const dir = path.join(process.cwd(), "public/data/state-budgets/states");
  const files = (await fs.readdir(dir)).filter((f) => f.endsWith(".json"));
  const states = await Promise.all(
    files.map(async (file) => JSON.parse(await fs.readFile(path.join(dir, file), "utf-8")) as StateData)
  );
  states.sort((a, b) => a.name.localeCompare(b.name));

  return states.map((state, index) => ({
    params: { abbr: state.abbr.toLowerCase() },
    props: {
      state,
      previous: states[(index - 1 + states.length) % states.length],
      next: states[(index + 1) % states.length],
      all: states.map((s) => ({ abbr: s.abbr, name: s.name })),
    },
  }));
}

const { state, previous, next, all } = Astro.props;

const years = state.years;
const last = years.length - 1;
const spending = years.map((_, i) =>
  Object.values(state.expenditure_by_function).reduce((sum, v) => sum + (v[i] ?? 0), 0)
);
const revenue = years.map((_, i) =>
  Object.values(state.revenue_by_source).reduce((sum, v) => sum + (v[i] ?? 0), 0)
);
const population = state.population;
const debtOutstanding = state.debt.outstanding_end ?? [];
const governor = governorForYear(state.governors, years[last], state.fiscal_year_start_month);

const fmtBillions = (v: number) => `$${(v / 1e9).toFixed(1)}B`;
const fmtDollars = (v: number) => `$${Math.round(v).toLocaleString()}`;
const change = (series: number[]) =>
  series[last - 1] ? (series[last] - series[last - 1]) / series[last - 1] : 0;

const operating = state.spending_split.operating;
const capital = state.spending_split.capital;
const debtService = state.debt_service;
const federalAid = state.revenue_by_source.federal_aid ?? [];

const tiles = [
  { label: `Total spending, FY${years[last]}`, value: fmtBillions(spending[last]), delta: change(spending), note: "Everything the state spent, operating and capital." },
  {
    label: "Spending per resident",
    value: population[last] ? fmtDollars(spending[last] / population[last]) : "—",
    delta: change(spending.map((v, i) => (population[i] ? v / population[i] : 0))),
    note: "Total spending divided by population.",
  },
  {
    label: "Long-term debt outstanding",
    value: fmtBillions(debtOutstanding[last] ?? 0),
    delta: change(debtOutstanding),
    note: "What the state still owes on money it has borrowed.",
  },
  {
    label: "Money from Washington",
    value: revenue[last] ? `${Math.round(((federalAid[last] ?? 0) / revenue[last]) * 100)}%` : "—",
    delta: null,
    note: `Federal grants and aid as a share of all revenue — ${fmtBillions(
      federalAid[last] ?? 0
    )} of ${fmtBillions(revenue[last])}. Mostly Medicaid matching funds.`,
  },
  {
    label: "Debt service",
    value: operating[last] ? `${((debtService[last] / operating[last]) * 100).toFixed(1)}%` : "—",
    delta: null,
    note: `Interest paid on debt, ${fmtBillions(
      debtService[last]
    )}, as a share of the operating budget. Repaying the principal is not counted as spending.`,
  },
];

const netBorrowing = years.map(
  (_, i) => (state.debt.issued?.[i] ?? 0) - (state.debt.retired?.[i] ?? 0)
);
const surplus = years.map((_, i) => revenue[i] - operating[i]);

const debtTable = {
  headers: ["Fiscal year", "Capital spending", "Net new borrowing", "Total owed"],
  rows: years.map((year, i) => [
    `FY${year}`,
    fmtBillions(capital[i]),
    fmtBillions(netBorrowing[i]),
    fmtBillions(debtOutstanding[i] ?? 0),
  ]),
};

const topFunctions = Object.entries(state.expenditure_by_function)
  .map(([key, values]) => ({ key, value: values[last] ?? 0 }))
  .sort((a, b) => b.value - a.value)
  .slice(0, 3);

const fyStart = new Date(Date.UTC(2000, state.fiscal_year_start_month - 1, 1)).toLocaleString("en-US", {
  month: "long",
  timeZone: "UTC",
});

const dataTable = {
  headers: ["Fiscal year", "Spending", "Revenue", "Debt outstanding"],
  rows: years.map((year, i) => [
    `FY${year}`,
    fmtBillions(spending[i]),
    fmtBillions(revenue[i]),
    fmtBillions(debtOutstanding[i] ?? 0),
  ]),
};
---

<BaseLayout
  title={`${state.name} budget`}
  description={`How ${state.name} spends, borrows and raises money, FY${years[0]}–FY${years[last]}, with the events that moved the budget.`}
>
  <article class="state">
    <nav class="crumbs">
      <a href={withBase("/investigations/state-budgets/")}>What Moves a State Budget</a>
      <span aria-hidden="true">·</span>
      <a href={withBase("/investigations/state-budgets/states/")}>All states</a>
    </nav>

    <header>
      <h1>{state.name}</h1>
      <p class="sub">
        Fiscal years {years[0]}–{years[last]}. {state.name}'s budget year begins in {fyStart}.
        {governor && (
          <>
            {" "}Currently governed by <strong>{governor.name}</strong>
            {governor.party && ` (${PARTY_NAMES[governor.party]})`}.
          </>
        )}
      </p>
    </header>

    <section class="tiles">
      {tiles.map((tile) => (
        <div class="tile">
          <span class="tile-label" title={tile.note}>{tile.label}</span>
          <span class="tile-value">{tile.value}</span>
          <span class="tile-note">{tile.note}</span>
          {tile.delta !== null && (
            <span class={`tile-delta ${tile.delta >= 0 ? "up" : "down"}`}>
              {tile.delta >= 0 ? "▲" : "▼"} {Math.abs(tile.delta * 100).toFixed(1)}% vs FY{years[last - 1]}
            </span>
          )}
        </div>
      ))}
    </section>

    <ChartFrame
      title="The operating budget has to balance"
      takeaway={`Revenue and operating spending track each other closely — ${state.name}, like almost every state, cannot run an operating deficit. Shaded bands mark each governor's term.`}
      source={{ label: "Census Annual Survey of State Government Finances", href: "https://www.census.gov/programs-surveys/state.html" }}
      table={dataTable}
    >
      <BudgetTimeline
        client:visible
        years={years}
        spending={operating}
        revenue={revenue}
        governors={state.governors}
        anomalies={state.anomalies}
        fiscalStartMonth={state.fiscal_year_start_month}
        population={population}
      />
    </ChartFrame>

    <section class="explainer">
      <h2>How the borrowing fits in</h2>
      <p>
        If the operating budget has to balance, where does the debt come from?
        They are two separate streams, and Census keeps them apart.
      </p>
      <dl>
        <div>
          <dt>Operating — {fmtBillions(operating[last])}</dt>
          <dd>
            Salaries, Medicaid, aid to school districts, prisons, and the
            interest on outstanding debt. This is the part that has to balance
            against revenue, so a rise in one category is usually a cut
            somewhere else — a reallocation, not new borrowing.
          </dd>
        </div>
        <div>
          <dt>Capital — {fmtBillions(capital[last])}</dt>
          <dd>
            Roads, buildings, land and equipment. States are allowed to borrow
            for these, which is what the bonds are for and why capital spending
            and new borrowing tend to move together.
          </dd>
        </div>
        <div>
          <dt>Debt service — {fmtBillions(debtService[last])}</dt>
          <dd>
            Interest <em>is</em> an operating cost and is counted in the figure
            above, at {operating[last]
              ? `${((debtService[last] / operating[last]) * 100).toFixed(1)}%`
              : "—"}{" "}
            of the operating budget. Repaying the principal is not counted as
            spending at all — it retires a liability, which is why "debt
            retired" never shows up in the spending charts.
          </dd>
        </div>
      </dl>
    </section>



    <EventLog anomalies={state.anomalies} disasters={state.disasters} />

    <ChartFrame
      title="Where the money goes"
      takeaway="Spending by function, stacked. Public welfare — which is mostly Medicaid — is the largest category in most states."
      source={{ label: "Census, author's classification of item codes", href: "https://www.census.gov/programs-surveys/state.html" }}
    >
      <FunctionBreakdown client:visible years={years} byFunction={state.expenditure_by_function} />
    </ChartFrame>

    <ChartFrame
      title="The debt story"
      takeaway={`Bars are the annual flows — what ${state.name} built, and how much it borrowed net of repayment. The shaded area behind them is the stock those flows accumulate into: what it still owes, and how much of that is really its own.`}
      source={{ label: "Census Annual Survey of State Government Finances", href: "https://www.census.gov/programs-surveys/state.html" }}
      table={debtTable}
    >
      <DebtStory
        client:visible
        years={years}
        capital={capital}
        operating={operating}
        revenue={revenue}
        debt={state.debt}
        byPurpose={state.debt_by_purpose}
        population={population}
      />
    </ChartFrame>

    <section class="explainer">
      <h3>Where capital money comes from</h3>
      <p>
        Two sources fund the building: whatever is left over after the operating
        budget balances, and borrowing. In {state.name}'s most recent year that
        was an operating surplus of {fmtBillions(surplus[last])} and net new
        borrowing of {fmtBillions(netBorrowing[last])}, against{" "}
        {fmtBillions(capital[last])} of capital spending.
      </p>
      <p class="caveat">
        Those don't add up, and they aren't meant to. A surplus doesn't have to
        go to capital — it can go to reserves or pension funds. Federal grants
        for things like highways arrive as revenue and pay for capital directly.
        Bonds are spent over the years a project takes, not in the year they are
        issued. And a good deal of each year's issuance refinances older debt
        rather than funding anything new. The two bars show the scale of the
        sources against the scale of the building; they are not an accounting
        identity, and across all fifty states the annual figures reconcile
        closely only about a fifth of the time.
      </p>
    </section>

    <nav class="pager">
      <a href={withBase(`/investigations/state-budgets/states/${previous.abbr.toLowerCase()}/`)}>
        ← {previous.name}
      </a>
      <label class="picker">
        <span class="visually-hidden">Jump to a state</span>
        <select data-state-picker>
          {all.map((s) => (
            <option value={s.abbr.toLowerCase()} selected={s.abbr === state.abbr}>
              {s.name}
            </option>
          ))}
        </select>
      </label>
      <a href={withBase(`/investigations/state-budgets/states/${next.abbr.toLowerCase()}/`)}>
        {next.name} →
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  document.querySelector<HTMLSelectElement>("[data-state-picker]")?.addEventListener("change", (event) => {
    const abbr = (event.target as HTMLSelectElement).value;
    window.location.href = `${base}/investigations/state-budgets/states/${abbr}/`;
  });
</script>

<style>
  .state {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 1rem 1rem 4rem;
  }

  .crumbs {
    font-size: 0.85rem;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .sub {
    color: var(--color-text-secondary);
    max-width: 68ch;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .tile-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .tile-value {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
  }

  .tile-note {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .tile-delta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .tile-delta.up {
    color: var(--color-good);
  }

  .tile-delta.down {
    color: var(--color-serious);
  }

  .explainer {
    margin: 2.5rem 0;
  }

  .explainer h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .explainer > p {
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .explainer .caveat {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    max-width: 62ch;
  }

  .explainer dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0;
  }

  .explainer dl > div {
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .explainer dt {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }

  .explainer dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .pager select {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-size: 0.9rem;
  }
</style>
